MYSQL_DATABASE =
MYSQL_USER =
MYSQL_PASSWORD =
MYSQL_HOST =
MYSQL_PORT =

PORT =

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
# Correo que envía los PIN de recuperación (Gmail + contraseña de aplicación)
SMTP_SERVICE=
SMTP_USER=
SMTP_PASS=

# Firma de las sesiones de los estudiantes (no compartir)
SESSION_SECRET=

# Asistente de IA (ChatGPT). La clave se crea en https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Correos que reciben las alertas de psicología (separados por coma).
# Si se deja vacío, se usan los correos de los usuarios con rol Psicologo/a activos.
PSICOLOGIA_CORREOS=

# Asistente de IA con Groq (plan gratuito). La clave se crea en https://console.groq.com/keys
# Si hay clave de Groq se usa Groq; si no, se usa OpenAI (OPENAI_API_KEY).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
